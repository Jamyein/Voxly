#!/bin/bash
# Pre-commit hook: remind to update lesson.md when source files change.
set -euo pipefail

has_source_changes() {
    # Check if any staged files are source files (.kt, .kts, .cpp, .h)
    git diff --cached --name-only --diff-filter=ACM | grep -qE '\.(kt|kts|cpp|h)$'
    return $?
}

has_lesson_changes() {
    git diff --cached --name-only --diff-filter=ACM | grep -q 'lesson\.md$'
    return $?
}

if has_source_changes && ! has_lesson_changes; then
    echo ""
    echo "⚠  lesson.md was not updated in this commit."
    echo "   If you encountered any error during this work, add an entry to lesson.md:"
    echo "   N. [Root cause]. Rule: [Preventive principle]."
    echo ""
fi
